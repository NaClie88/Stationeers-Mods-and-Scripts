# Phase Change Separator -- single-stage, table-driven condensation
# controller. NEW SCRIPT for this project (not adapted from an
# external source) -- see phase_separator_notes.md for the full design
# rationale and hardware layout, and condensation_reference.md for
# where the values below come from (real Stationpedia phase diagrams,
# not a guess) and how to point this at a different gas.

alias Sensor d0
alias Vent d1
alias Drain d2

define TargetPressure 6000  # Nitrogen, ~6000 kPa/190K -- see condensation_reference.md
define TargetTemp 189.95
define PressureTolerance 50
define TempTolerance 1
define SettleTicks 20
define DrainTicks 40

alias StableCount r10
alias DrainCount r11

init:
move StableCount 0
move DrainCount 0
s Vent Mode 0
s Vent On 0
s Drain On 0

loop:
yield
bgtz DrainCount draining
brdns Sensor noSensor
l r0 Sensor Pressure
l r1 Sensor Temperature
sub r2 r0 TargetPressure
abs r2 r2
bgt r2 PressureTolerance adjustPressure
s Vent On 0
j checkTemp
adjustPressure:
move StableCount 0
sgt r3 r0 TargetPressure
beqz r3 pressureLow
s Vent Mode 0
s Vent On 1
j loop
pressureLow:
s Vent Mode 1
s Vent On 1
j loop
checkTemp:
sub r2 r1 TargetTemp
abs r2 r2
bgt r2 TempTolerance notStable
add StableCount StableCount 1
blt StableCount SettleTicks loop
s Drain On 1
move DrainCount DrainTicks
j loop
notStable:
move StableCount 0
j loop
noSensor:
# Sensor is a hard requirement here, no fallback reading makes sense --
# this just stops an unplugged/removed Sensor from faulting the whole
# chip mid-tick (a pin read, unlike a batch read, errors out on an
# empty slot) and leaving the Vent stuck running from whatever it was
# last commanded to. Idles the Vent to a known-safe state and resets
# StableCount so a returning Sensor has to reconfirm stability from
# scratch rather than resuming a stale count. Doesn't touch an
# already-running drain -- that's handled above and doesn't need the
# Sensor at all.
s Vent On 0
move StableCount 0
j loop
draining:
sub DrainCount DrainCount 1
bgtz DrainCount loop
s Drain On 0
move StableCount 0
j loop
