# Cycle chip - Re-Volt Data Diode variant. HYPOTHESIS, unverified
# in-game - see PARTS_DELTA.md "Simplification candidate" before
# trusting this. Pairs with watcher.ic10 in this same folder - read
# that file's header first.
#
# Same Doors/Vent/chamber Gas Sensor state machine as vanilla. The one
# real change: no Receiver (2nd Logic Transmitter, Passive mode), no
# unpack-the-Setting-value block. Reads Watcher's Buttons directly by
# name (same BtnHash/names Watcher itself uses) and reads Watcher's LED
# Color directly for Tier, instead of receiving a relayed value.
#
# LEDHash is a fresh, UNCONFIRMED type-hash (same standard as BtnHash
# below) - verify against Stationpedia before relying on it. If it's
# wrong, this chip silently sees nothing rather than erroring (same
# batch-read behavior already documented for the Gas Sensor chip's
# PropFlagHash pattern) - Tier would default to Critical (see tierSet
# below) and the airlock would sit permanently locked down, so this is
# worth checking first, not last.
#
# gas_sensor.ic10 (this project's Propped-Open chip) is UNCHANGED under
# this variant - it never touched the Transmitter/Receiver pair, use
# the vanilla ic10-airlock/gas_sensor.ic10 as-is if you build it.

alias DoorExt d1
alias DoorInt d2
alias Vent d3
alias ChamberSensor d5

define PropFlagHash -1234567
define TargetInt 100
define TargetExt 2

define BtnHash -1591419276
define BtnEName HASH("AirlockBtnE")
define BtnIName HASH("AirlockBtnI")
define BtnCName HASH("AirlockBtnC")
define LEDHash HASH("StructureDiode")
define ColorGreen 2
define ColorYellow 5

move r10 0
move r11 0
move r13 0

loop:
lbn r6 BtnHash BtnEName Activate 0
lbn r7 BtnHash BtnIName Activate 0
lbn r8 BtnHash BtnCName Activate 0
lb r9 LEDHash Color 0

move r0 2
beq r9 ColorGreen isGreen
beq r9 ColorYellow isYellow
j tierSet
isGreen:
move r0 0
j tierSet
isYellow:
move r0 1
tierSet:

beq r0 2 tierCrit
beq r0 0 checkProp
j cycleCheck

checkProp:
lb r5 PropFlagHash Setting 0
beqz r5 cycleCheck
s DoorExt Open 1
s DoorInt Open 1
j endLoop

cycleCheck:
bgtz r11 doorTimer
bnez r13 continueCycle
l r14 DoorExt Open
l r15 DoorInt Open
bgtz r14 endLoop
bgtz r15 endLoop
bnez r6 reqExt
bnez r7 reqInt
j endLoop

reqExt:
beq r10 0 openExt
move r13 1
j endLoop
openExt:
s DoorExt Open 1
move r11 10
j endLoop

reqInt:
beq r10 1 openInt
move r13 2
j endLoop
openInt:
s DoorInt Open 1
move r11 10
j endLoop

continueCycle:
beq r13 1 evacuate
j pressurize

evacuate:
s Vent Mode 0
s Vent On 1
l r12 ChamberSensor Pressure
bgt r12 TargetExt endLoop
s Vent On 0
move r10 0
move r13 0
s DoorExt Open 1
move r11 10
j endLoop

pressurize:
s Vent Mode 1
s Vent On 1
l r12 ChamberSensor Pressure
blt r12 TargetInt endLoop
s Vent On 0
move r10 1
move r13 0
s DoorInt Open 1
move r11 10
j endLoop

doorTimer:
sub r11 r11 1
bgtz r11 endLoop
s DoorExt Open 0
s DoorInt Open 0
j endLoop

tierCrit:
bnez r8 endLoop
s DoorExt Open 0
s DoorInt Open 0
s Vent Mode 0
s Vent On 1
l r12 ChamberSensor Pressure
bgt r12 TargetExt endLoop
s Vent On 0
s DoorExt Lock 0
s DoorInt Lock 0

endLoop:
yield
j loop
